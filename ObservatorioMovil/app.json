{
  "expo": {
    "name": "Observatorio Huaquechula",
    "slug": "observatorio-huaquechula",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDEBE3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.observatorio.huaquechula"
    },
    "android": {
      "package": "com.observatorio.huaquechula",
      "usesCleartextTraffic": true,
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EDEBE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "fb32f6d0-9e97-4f81-9fd9-915b35df01b8"
      }
    },
    "owner": "aetherexpo4060"
  }
}
